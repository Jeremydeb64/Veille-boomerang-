{
  "manifest_version": 3,
  "name": "Le Pouls — Accueil",
  "short_name": "Le Pouls",
  "description": "Page d'accueil Boomerang : heure, météo, recherche Google, raccourcis, agenda et actualité du Pouls.",
  "version": "1.0.0",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://picsum.photos/*",
    "https://raw.githubusercontent.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://*.office.com/*"
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
